# =================================================================
# CORE AI CHATBOT - Environment Configuration Template
# =================================================================
# Copy this file to .env and fill in your actual values
# DO NOT commit .env file to version control
# =================================================================

# =================================================================
# APPLICATION SETTINGS
# =================================================================
APP_NAME="CORE AI Chatbot API"
APP_VERSION="1.0.0"
APP_DESCRIPTION="Enterprise-grade AI chatbot API with Mistral AI integration"
ENVIRONMENT=development
DEBUG=true

# =================================================================
# SERVER CONFIGURATION
# =================================================================
HOST=0.0.0.0
PORT=8000

# =================================================================
# API CONFIGURATION
# =================================================================
API_V1_PREFIX=/api/v1

# =================================================================
# CORS SETTINGS
# =================================================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true

# =================================================================
# DATABASE CONFIGURATION
# =================================================================
# Choose ONE database configuration below and uncomment it

# PostgreSQL (Recommended for Production)
# DATABASE_URL=postgresql+asyncpg://chatbot_user:your_password@localhost:5432/chatbot_db

# MySQL/MariaDB
# DATABASE_URL=mysql+aiomysql://chatbot_user:your_password@localhost:3306/chatbot_db

# SQLite (Good for Development/Testing)
DATABASE_URL=sqlite+aiosqlite:///./chatbot.db

# MongoDB (Alternative NoSQL option)
# DATABASE_URL=mongodb://localhost:27017/chatbot_db

# Database Pool Settings
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# =================================================================
# REDIS CONFIGURATION (Optional - for caching and sessions)
# =================================================================
# REDIS_URL=redis://localhost:6379/0
# REDIS_PASSWORD=your_redis_password
# REDIS_DB=0

# =================================================================
# MISTRAL AI CONFIGURATION (Required)
# =================================================================
# Get your API key from: https://console.mistral.ai/
MISTRAL_API_KEY=your_mistral_api_key_here
MISTRAL_API_URL=https://api.mistral.ai/v1/chat/completions
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=4096
MISTRAL_TEMPERATURE=0.7
MISTRAL_TIMEOUT=120

# =================================================================
# AWS BEDROCK CONFIGURATION (Optional - Alternative AI Provider)
# =================================================================
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# =================================================================
# SECURITY CONFIGURATION
# =================================================================
# IMPORTANT: Generate a strong secret key for production
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-change-in-production-minimum-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# =================================================================
# RATE LIMITING
# =================================================================
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# =================================================================
# LOGGING CONFIGURATION
# =================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/app.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# =================================================================
# MONITORING & METRICS
# =================================================================
ENABLE_METRICS=true

# Sentry Error Tracking (Optional)
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# =================================================================
# SESSION & CACHE SETTINGS
# =================================================================
SESSION_TIMEOUT_MINUTES=60
CACHE_TTL_SECONDS=3600

# =================================================================
# CONVERSATION SETTINGS
# =================================================================
MAX_CONVERSATION_HISTORY=50
MAX_MESSAGE_LENGTH=10000
DEFAULT_SYSTEM_PROMPT="You are a helpful AI assistant. You are knowledgeable, helpful, and provide accurate, well-structured responses."

# =================================================================
# FILE UPLOAD SETTINGS (Future Feature)
# =================================================================
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list
ALLOWED_UPLOAD_EXTENSIONS=.txt,.pdf,.doc,.docx

# =================================================================
# BACKGROUND TASKS (Optional - if using Celery)
# =================================================================
# CELERY_BROKER_URL=redis://localhost:6379/1
# CELERY_RESULT_BACKEND=redis://localhost:6379/2

# =================================================================
# DEVELOPMENT TOOLS
# =================================================================
# Enable/disable API documentation endpoints
# Set to false in production for security
DOCS_ENABLED=true
REDOC_ENABLED=true

# =================================================================
# DOCKER CONFIGURATION (for docker-compose)
# =================================================================
# These are used by docker-compose.yml
POSTGRES_DB=chatbot_db
POSTGRES_USER=chatbot_user
POSTGRES_PASSWORD=chatbot_password

# =================================================================
# NOTES
# =================================================================
# 1. Never commit the actual .env file to version control
# 2. Keep .env.example updated with all available options
# 3. Generate strong random values for SECRET_KEY
# 4. Use different values for development, staging, and production
# 5. Rotate secrets regularly in production
# 6. Use environment-specific files: .env.production, .env.staging
# =================================================================
